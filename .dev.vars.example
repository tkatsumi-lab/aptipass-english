NEXTJS_ENV=development

# Required for /admin/affiliate. Copy this file to .dev.vars (gitignored)
# and fill in real values for local testing. In production, set these as
# Cloudflare Worker secrets instead — never commit real credentials:
#   npx wrangler secret put ADMIN_USERNAME
#   npx wrangler secret put ADMIN_PASSWORD
ADMIN_USERNAME=
ADMIN_PASSWORD=
